<!--
  Autobeat launcher foreground (from autobeat-icon-foreground.svg).

  Two decks crossing = auto mix; the filled lens is the crossfade moment.
  Circles are written as arc paths (VectorDrawable has no <circle>); the lens
  is a two-arc path instead of a clip so it renders on every API level.
  Background lives in ic_launcher_background.xml — this layer is all mark.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
  <path
      android:fillColor="#00000000"
      android:strokeColor="#FF01FF95"
      android:strokeWidth="16"
      android:pathData="M124,256 A84,84 0 1 0 292,256 A84,84 0 1 0 124,256 Z" />
  <path
      android:fillColor="#00000000"
      android:strokeColor="#FF01FF95"
      android:strokeWidth="16"
      android:pathData="M220,256 A84,84 0 1 0 388,256 A84,84 0 1 0 220,256 Z" />
  <path
      android:fillColor="#FF01FF95"
      android:pathData="M256,187.06 A84,84 0 0 1 256,324.94 A84,84 0 0 0 256,187.06 Z" />
</vector>
