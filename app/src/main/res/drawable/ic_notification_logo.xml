<!--
  Status-bar / notification variant of the Autobeat mark.

  Notification small icons are drawn as a silhouette: the system throws away
  every colour and keeps only the alpha channel, so everything here is opaque
  white. The stroke is deliberately heavier than the launcher art — at 24dp
  the true 16-unit ring would melt into a blob.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
  <path
      android:fillColor="#00000000"
      android:strokeColor="#FFFFFFFF"
      android:strokeWidth="40"
      android:pathData="M124,256 A84,84 0 1 0 292,256 A84,84 0 1 0 124,256 Z" />
  <path
      android:fillColor="#00000000"
      android:strokeColor="#FFFFFFFF"
      android:strokeWidth="40"
      android:pathData="M220,256 A84,84 0 1 0 388,256 A84,84 0 1 0 220,256 Z" />
  <path
      android:fillColor="#FFFFFFFF"
      android:pathData="M256,187.06 A84,84 0 0 1 256,324.94 A84,84 0 0 0 256,187.06 Z" />
</vector>
